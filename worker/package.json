{
  "name": "jitney-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Jitney control plane: ingress Worker, Scheduler Durable Object, runner Container Durable Objects",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "fmt": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm knip && pnpm test"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.99",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@jitney/shared": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.26.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "knip": {
    "entry": [
      "test/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "test/**/*.ts"
    ],
    "ignoreDependencies": [
      "cloudflare"
    ]
  }
}
