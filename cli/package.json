{
  "name": "get-jitney",
  "version": "0.2.0",
  "description": "Deploy Jitney to Cloudflare and configure its GitHub App",
  "homepage": "https://github.com/LoriKarikari/jitney#readme",
  "bugs": "https://github.com/LoriKarikari/jitney/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoriKarikari/jitney.git",
    "directory": "cli"
  },
  "bin": {
    "jitney": "dist/cli.js"
  },
  "files": [
    "assets",
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:worker && tsup src/cli.ts --format esm --clean",
    "prepack": "pnpm build",
    "build:worker": "wrangler deploy --dry-run --config wrangler.bundle.json --outdir assets/worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "0.29.1",
    "@distilled.cloud/cloudflare-runtime": "0.13.5",
    "@effect/platform-node": "4.0.0-beta.99",
    "@octokit/auth-app": "catalog:",
    "@octokit/request": "^10.0.11",
    "alchemy": "2.0.0-beta.63",
    "effect": "catalog:",
    "open": "^11.0.0",
    "tar": "^7.5.20",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@jitney/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
